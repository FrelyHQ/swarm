# Local adapter settings. Keep credentials in files, not in this file.
PORT=8787
FRELY_GATEWAY_URL=http://host.docker.internal:8080
SNAP_SWARM_URL=http://host.docker.internal:8788
SNAP_REQUIRE_SWARM=true
SNAP_MODEL=default
SNAP_TIMEOUT_MS=10000
# Compose reads this file through the secret mount.
SNAP_GATEWAY_SECRET_FILE=./secrets/gateway_api_key
# Optional; leave unset or point at an empty file when the probe needs no key.
SNAP_SWARM_SECRET_FILE=./secrets/swarm_probe_key
# Optional local admission header for a gateway that requires one.
# GATEWAY_HOST=local.gateway
