# Public development port; keep it bound to loopback.
SWARM_PORT=4111

# Backing model configuration. MODEL_API_KEY is supplied through a Docker
# secret, never in this file.
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-5.6-luna
SWARM_PUBLIC_MODEL=vision-basic
MODEL_TIMEOUT_MS=120000

# Host paths read by Docker Compose. Create these files locally and do not
# commit them.
MODEL_API_KEY_SECRET_FILE=./secrets/model_api_key
SWARM_ACCESS_TOKEN_SECRET_FILE=./secrets/swarm_access_token

# Set true only for an explicitly selected non-loopback HTTP development model.
# SWARM_ALLOW_INSECURE_MODEL_HTTP=false
