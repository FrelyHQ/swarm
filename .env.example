# Public development port; keep it bound to loopback.
SWARM_PORT=4111

# Swarm's only model boundary is the local Frely base-model entry.
FRELY_BASE_URL=http://gateway-srv:43000/v1
FRELY_MODEL=dev-base
SWARM_PUBLIC_MODEL=vision-basic
FRELY_TIMEOUT_MS=120000
FRELY_DEV_NETWORK=frely-dev

# Paths are generated by the Frely local-development setup and stay outside Git.
FRELY_API_KEY_SECRET_FILE=../.local/frely-compose-dev/swarm-frely-api-key
SWARM_ACCESS_TOKEN_SECRET_FILE=../.local/frely-compose-dev/swarm-access-token
