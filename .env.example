# Snap listens locally; keep the published port on loopback.
SNAP_PORT=8787

# The Gateway root or its /v1 API base. These defaults target local sibling
# services published by the standard development setup.
FRELY_GATEWAY_URL=http://host.docker.internal:43000
SNAP_SWARM_URL=http://host.docker.internal:4111
SNAP_REQUIRE_SWARM=true

# Select a model that is enabled for the configured Frely API key.
SNAP_MODEL=replace-with-enabled-model
SNAP_TIMEOUT_MS=30000

# Compose reads these host paths and mounts them as secrets. Do not put key
# material in this file.
SNAP_GATEWAY_SECRET_FILE=./secrets/gateway_api_key
SNAP_SWARM_SECRET_FILE=./secrets/swarm_probe_key

# Optional local Host header for a Gateway that validates the incoming host.
# GATEWAY_HOST=gateway-srv
